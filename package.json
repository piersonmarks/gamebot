{
  "name": "@gamebot/core",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/browser", "packages/*"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/core", "dist/eval", "dist/memory", "dist/learning", "dist/models", "dist/skills", "dist/index.*", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:core && npm run build --workspaces",
    "build:core": "tsc -p tsconfig.json",
    "game": "node scripts/game.mjs",
    "autoplay": "node scripts/game.mjs --autoplay",
    "report": "node scripts/report.mjs",
    "demo": "node dist/demo.js",
    "watch": "npm run build:core && node dist/demo.js --watch",
    "watch:ai": "npm run build:core && node dist/demo.js --watch --ai",
    "chess": "npm run game -- --game=chess",
    "snake": "npm run game -- --game=snake",
    "snake:window": "npm run game -- --game=snake",
    "2048": "npm run game -- --game=2048"
  },
  "dependencies": {
    "@types/node": "^22.20.3",
    "ai": "^7.0.111",
    "quickjs-emscripten": "^0.32.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  }
}
