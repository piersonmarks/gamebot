{
  "name": "gamebot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo": "node dist/demo.js",
    "watch": "npm run build && node dist/demo.js --watch",
    "watch:ai": "npm run build && node dist/demo.js --watch --ai"
  },
  "dependencies": {
    "@types/node": "^22.20.3",
    "ai": "^7.0.111",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  }
}
